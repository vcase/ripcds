{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RipBook",
  "version": "0.1.0",
  "identifier": "com.ripbook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RipBook",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Resumable audiobook CD ripper",
    "longDescription": "Rip multi-disc audiobooks with fre:ac, track disc completion, and resume where you left off.",
    "resources": [
      "resources/freac/**/*",
      "resources/purge-installer-data.ps1"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
